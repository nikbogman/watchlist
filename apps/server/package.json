{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env src/auth/seed.ts",
    "reel:login": "playwright install chromium && tsx --env-file-if-exists=.env src/reels/login.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.6",
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
